# Nebius Token Factory API key (https://tokenfactory.nebius.com). Required for live inference.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint of Nebius Token Factory
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NVIDIA open models served by Token Factory
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
# Abuse / cost controls for the public demo
RATE_LIMIT_RUNS=6
RATE_LIMIT_WINDOW_S=600
DAILY_BUDGET_USD=5
LLM_CONCURRENCY=16
RUNS_DIR=/tmp/specfork-runs
