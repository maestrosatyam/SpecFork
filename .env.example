# API key for the default model profiles (NVIDIA Nemotron on Nebius Token Factory: https://tokenfactory.nebius.com).
# Other providers: add profiles to specfork.toml (see docs/PROVIDERS.md) and set their key_env variables here.
NEBIUS_API_KEY=

# Model profile keys (see specfork/models.toml). Defaults: lightning (NVIDIA Nemotron 3.5 Lightning) and
# ultra (NVIDIA Nemotron 3 Ultra). SPECFORK_IMPLEMENTERS=lightning,local mixes model families in the fan-out.
SPECFORK_FAST_MODEL=lightning
SPECFORK_DEEP_MODEL=ultra
# SPECFORK_IMPLEMENTERS=
# SPECFORK_MODELS_FILE=specfork.toml

# Look for silent assumptions (1/0)
SPECFORK_ASSUMPTIONS=1
# SQLite file for runs when self-hosting ("" = memory only; ignored when SPECFORK_PUBLIC_DEMO=1)
SPECFORK_DB=specfork.db
# Public-demo hardening: no OpenAPI, memory-only store, priced models only
SPECFORK_PUBLIC_DEMO=0

# Abuse / cost controls (web server)
RATE_LIMIT_RUNS=6
RATE_LIMIT_WINDOW_S=600
DAILY_BUDGET_USD=5
LLM_CONCURRENCY=16

# Sandbox: refuse to run model code without network isolation (recommended on servers)
SANDBOX_REQUIRE_ISOLATION=0
